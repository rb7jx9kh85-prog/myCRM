{
  "crons": [
    { "path": "/api/cron/daily-digest", "schedule": "0 6 * * *" }
  ],
  "functions": {
    "api/crm-agent.js": { "maxDuration": 60 },
    "api/files/upload.js": { "maxDuration": 30 },
    "api/files/download.js": { "maxDuration": 30 },
    "api/files/remove.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
